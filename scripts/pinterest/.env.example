# Pinterest API v5 credentials
# Copy this file to .env and fill in your values.
# Get App ID and Secret from: https://developers.pinterest.com → My apps → your app

# Required: from your Pinterest Developer app settings
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Populated automatically by: python pinterest_test.py auth
# Access token expires after ~30 days. Script auto-refreshes on 401.
PINTEREST_ACCESS_TOKEN=

# Populated automatically by: python pinterest_test.py auth
# Refresh token expires after ~1 year.
PINTEREST_REFRESH_TOKEN=
